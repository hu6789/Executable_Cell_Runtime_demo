      "X_free": "GLI3.free"
    }
  },
  "resources": {
    "consumption": {
      "ATP": 0.5
    },
    "occupancy": {
      "enzyme": 0.1
    }
  },
  "internal_outputs": {
    "node": {
      "source": {
        "target": "GLI3",
        "state": "free",
        "mode": "consume"
      },
      "product": {
        "target": "GLI3",
        "state": "repressor",
        "mode": "produce"
      }
    }
  }
}
